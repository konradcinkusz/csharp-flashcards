% mybeamer.sty
\ProvidesPackage{mybeamer}[2025/07/31 Styles and macros]

%% Question/Answer numbering
\newcounter{qcounter}
\setcounter{qcounter}{0}

%% Badge macro (unchanged)
\NewDocumentCommand{\CategoryBadge}{ o m }{%
  \tikz[baseline=(b.base)]{
    \node[
      fill=\IfValueTF{#1}{#1}{gray!20},
      rounded corners=1pt,
      inner sep=1pt,
      font=\footnotesize\bfseries
    ] (b) {#2};
  }%
}

\newcommand{\TOCButtonTall}[3]{%
  % #1 = beamer color name
  % #2 = hypertarget name
  % #3 = button label (can contain \\)
  \begin{beamercolorbox}[%
      wd=0.45\textwidth,  % two across
      sep=1.2ex,          % inner padding top & bottom
      center,             % center horizontally
      rounded=true,shadow=true]{#1}%
    \vbox to 3.5ex{%      % force a uniform height
      \vfil%             % push text vertically to center
      \centering
      \hyperlink{#2}{\Large\usebeamerfont{#1}#3}
      \vfil
    }%
  \end{beamercolorbox}%
}

%% ------------------------------------------------------------------------
%% Difficulty:            \Difficulty{1|2|3}
%%
%% Cards used to encode difficulty by prefixing the question string with
%% asterisks -- \QuestionSlide[...]{** What is a Service Mesh?}. LaTeX has no
%% idea that is metadata, so the asterisks were typeset: the reader saw
%% "12. ** What is a Service Mesh?" on the card, and again in the outline
%% frame at every section start, because \QuestionSlide opens a \subsection
%% with the same string.
%%
%% The three levels, so a rating means the same thing on every card:
%%
%%   1  Recall. You either know the term or you do not; no reasoning needed.
%%   2  Working knowledge. You have used this and can explain what it does
%%      and when to reach for it.
%%   3  Depth. Needs the trade-off, the failure mode, or the mechanism
%%      underneath -- the kind of answer an interviewer follows up on.
%%
%% Writing them down is the point. The scale was applied for months with no
%% definition anywhere, which is how the deck ended up with a three-way split
%% and eight cards carrying no rating at all.
%%
%% Out-of-range values are a build error rather than a silent miscount: a
%% rating is metadata and a typo in it is invisible on the page.
%% ------------------------------------------------------------------------
\newcommand{\mfa@diffdots}[3]{%
  \tikz[baseline=-0.35ex]{%
    \fill[#1] (0,0)      circle (0.32ex);
    \fill[#2] (1.05ex,0) circle (0.32ex);
    \fill[#3] (2.10ex,0) circle (0.32ex);
  }%
}
\colorlet{DiffOn}{black!75}
\colorlet{DiffOff}{black!18}

\NewDocumentCommand{\Difficulty}{ m }{%
  \ifcase#1\relax
    \PackageError{mybeamer}{\string\Difficulty\space takes 1, 2 or 3, not 0}{}%
  \or \mfa@diffdots{DiffOn}{DiffOff}{DiffOff}%
  \or \mfa@diffdots{DiffOn}{DiffOn}{DiffOff}%
  \or \mfa@diffdots{DiffOn}{DiffOn}{DiffOn}%
  \else
    \PackageError{mybeamer}{\string\Difficulty\space takes 1, 2 or 3}{}%
  \fi
}

%% ------------------------------------------------------------------------
%% Question slide:              \QuestionSlide[<badge>]{<question>}
%% ------------------------------------------------------------------------
\NewDocumentCommand{\QuestionSlide}{ o d<> m }{%
  % #1 = optional badge   #2 = optional difficulty 1-3   #3 = question
  \stepcounter{qcounter}%
  \subsection{Q\theqcounter: #3}%
  \begin{frame}%
    % badge overlay, with the difficulty rating beside it
    \IfValueT{#1}{%
      \begin{tikzpicture}[remember picture,overlay]
        \node[
          anchor=north east,
          xshift=-0.4cm,  % inset from right border
          yshift=-0.4cm   % inset from top border
        ] at (current page.north east)
        {#1\IfValueT{#2}{\,\Difficulty{#2}}};
      \end{tikzpicture}%
    }%
    % centered question
    \centering
    {\Large \theqcounter.\ #3\par}
  \end{frame}%
}

%% ------------------------------------------------------------------------
%% Answer frame title:   \frametitle{\AnswerTitle[<badge>]{<short title>}}
%%
%% The badge overlay used to be written out longhand in every answer frame --
%% the same eight lines each time, 1,122 of the 7,617 lines under areas/, and
%% the reason the deck had drifted into two spellings of
%% `remember picture,overlay' and three different inset values.
%%
%% Why this is a TITLE macro and not a whole-frame one, which is what you would
%% reach for first: this file used to define
%%
%%     \AnswerSlide[<badge>]{<short title>}{<body>}
%%
%% taking the frame body as an argument. It was never used by a single card in
%% the deck, and it cannot be. 197 of the 270 answer frames contain minted, and
%% a macro argument has no line structure. Measured rather than assumed --
%% converting one card to it gives
%%
%%     ./areas/4-LINQ.tex:29: FancyVerb Error:
%%       Extraneous input `... var names = context.Customers .Select(c =>
%%       c.CustomerName) .ToList(); ...' between \begin{minted}[<key=value>]
%%       and line end
%%
%% because by the time minted sees its content the newlines are gone. beamer's
%% [fragile] wants the same thing from the other end: it scans the SOURCE for
%% \end{frame}, so a frame generated inside a macro cannot be fragile either.
%%
%% So the frame and its body stay in the card file where verbatim needs them,
%% and only the part that is genuinely identical every time moves in here. The
%% inset is 0.4cm and the node carries text=black, matching what the 270
%% hand-rolled frames did, so the rendered page is unchanged.
%% ------------------------------------------------------------------------
\NewDocumentCommand{\AnswerTitle}{ o m }{%
  % #1 = optional badge   #2 = short title
  \IfValueT{#1}{%
    \begin{tikzpicture}[remember picture, overlay]
      \node[
        anchor=north east,
        xshift=-0.4cm,
        yshift=-0.4cm,
        text=black
      ] at (current page.north east) {#1};
    \end{tikzpicture}%
  }%
  Answer \theqcounter: #2%
}

%% ------------------------------------------------------------------------
%% Chunked TOC helper (unchanged)
%% ------------------------------------------------------------------------
\newcommand{\ChunkedTOC}[2][30]{%
  \foreach \start in {1,\numexpr#1+1\relax,...,#2} {
    \edef\endsec{\number\numexpr\start + #1 - 1\relax}%
    \begin{frame}{Table of Contents}%
      \scriptsize
      \begin{multicols}{2}
        \tableofcontents[sections={\start-\endsec}, hideallsubsections]
      \end{multicols}
    \end{frame}%
  }
}

